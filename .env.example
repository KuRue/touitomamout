# Data source
TWITTER_HANDLE="username"

# API
TWITTER_USERNAME="username"
TWITTER_PASSWORD="password"
# Optional: required if X asks for email verification during login
TWITTER_EMAIL=""
# Optional: TOTP secret if your X account has 2FA enabled
TWITTER_2FA_SECRET=""
# Optional (recommended fallback): raw browser cookies ("ct0=...; auth_token=...").
# Export from a logged-in browser session. Bypasses Cloudflare 403 / error 399
# anti-bot blocks that reject username+password logins from servers (e.g. Unraid).
TWITTER_COOKIES=""
# Optional: experimental X headers. Try "true" if you see x-client-transaction-id
# / KEY_BYTE errors. Leave "false" otherwise (can cause other failures).
TWITTER_EXPERIMENTAL_X_CLIENT_TRANSACTION_ID="false"
TWITTER_EXPERIMENTAL_XPFF="false"
MASTODON_INSTANCE="mastodon.social"
MASTODON_ACCESS_TOKEN=""
BLUESKY_INSTANCE=""
BLUESKY_IDENTIFIER=""
BLUESKY_PASSWORD=""

# Touitomamout
SYNC_MASTODON="true"
SYNC_BLUESKY="true"
SYNC_FREQUENCY_MIN="30"
SYNC_LOOKBACK_DAYS="21"
# Number of X posts to inspect per run. Increase for backfill, e.g. 1000.
SYNC_FETCH_COUNT="200"
# Maximum eligible posts to publish per run. 0 means unlimited.
SYNC_MAX_POSTS_PER_RUN="0"
SYNC_PROFILE_DESCRIPTION="false"
SYNC_PROFILE_PICTURE="false"
SYNC_PROFILE_HEADER="false"
SYNC_PROFILE_NAME="false"
BACKDATE_BLUESKY_POSTS="true"
